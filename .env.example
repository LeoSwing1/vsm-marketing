# --- Public (baked into the static build) ---
PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_GSC_VERIFICATION=            # Search Console "HTML tag" content value
PUBLIC_GOOGLE_PLACE_ID=             # for live Google reviews
PUBLIC_GOOGLE_PLACES_KEY=           # Places API (New), restrict to https://vsmgrowth.com/*

# --- Sanity (build time; leave empty to use src/content/site.ts) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=                  # only if the dataset is private

# --- /api/lead secrets (set in Vercel or Cloudflare dashboard, not here) ---
# ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET, ZOHO_REFRESH_TOKEN
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in   ZOHO_API_URL=https://www.zohoapis.in
# LEAD_WEBHOOK_URL (optional: Google Sheet / Make / Zapier backup)
# ANTHROPIC_API_KEY (competitor-analysis chatbot; without it the bot uses its built-in checklist)
# CHAT_MODEL=claude-haiku-5-5   ANTHROPIC_VERSION=2023-06-01

# --- Sanity Studio service (/admin/ on Vercel) ---
SANITY_STUDIO_PROJECT_ID=
