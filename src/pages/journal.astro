---
import Base from '../layouts/Base.astro';
import SubHero from '../components/SubHero.astro';
import NotesFromStudio from '../components/NotesFromStudio.astro';
import ContactBand from '../components/ContactBand.astro';
import { notes } from '../content/notes';
const schema = { '@context': 'https://schema.org', '@type': 'Blog', name: 'Notes from the studio — VSM Marketing', url: 'https://vsmgrowth.com/journal/', publisher: { '@id': 'https://vsmgrowth.com/#org' },
  blogPost: notes.map((n) => ({ '@type': 'BlogPosting', headline: n.title, url: `https://vsmgrowth.com/journal/${n.slug}/`, datePublished: n.date })) };
---
<Base title="Notes from the Studio | VSM Marketing Journal" description="Practical notes from VSM Marketing on reels, Google Maps ranking, Meta Ads and growing a local brand in Meerut, Noida and Delhi NCR." schema={schema}>
  <SubHero crumb={[{ label: 'Home', href: '/' }, { label: 'Journal' }]} lead="Short, practical notes from our team on reels, local search, ads and growing a local brand.">Notes from<br><em>the studio.</em></SubHero>
  <NotesFromStudio limit={99} heading={false} />
  <ContactBand n="—" />
</Base>
