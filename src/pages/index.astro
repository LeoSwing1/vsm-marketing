---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import ServiceList from '../components/ServiceList.astro';
import Industries from '../components/Industries.astro';
import Approach from '../components/Approach.astro';
import Pricing from '../components/Pricing.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import Pillars from '../components/Pillars.astro';
import Brands from '../components/Brands.astro';
import Different from '../components/Different.astro';
import Certified from '../components/Certified.astro';
import Team from '../components/Team.astro';
import HeroTags from '../components/HeroTags.astro';
import { getSite } from '../lib/content';
const s = await getSite();
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base home title="VSM Marketing | Digital Marketing Agency in Delhi, Noida & Meerut"
  description="VSM Marketing brings social media, Meta & Google Ads, SEO, video production, web development and PR together to make brands impossible to ignore. Meerut & Noida, since 2021."
  schema={faqSchema}>
  <section class="hero dark">
    <div class="hero-canvas" id="hero-canvas"></div>
    <div class="hero-copy">
      <p class="eyebrow"><span class="live-dot"></span>Independent growth partner · India</p>
      <h1 class="split" data-hero-title>Make your brand<br><em>impossible</em> to ignore.</h1>
      <div class="hero-bottom">
        <p>A digital marketing agency in Delhi, Noida and Meerut. We bring social media, paid ads, SEO, video and web together, run by one team from first idea to monthly report.</p>
        <a class="text-link" href="#work" data-track="cta_hero">Explore selected work <i>↓</i></a>
      </div>
      <HeroTags mobile />
    </div>
    <div class="hero-visual">
      <div class="visual-label">VSM / CREATIVE ENGINEERING</div>
      <div class="visual-cross" aria-hidden="true">✳</div>
      <div class="hero-orbit-label">IDEAS INTO<br>IMPACT <span>↗</span></div>
      <p class="hold-hint" aria-hidden="true">Move to stir · click to burst</p>
      <HeroTags />
    </div>
    <div class="hero-foot"><span>STRATEGY — CREATIVE — PERFORMANCE — TECHNOLOGY</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
  <Pillars />

  <section class="intro section-pad">
    <p class="eyebrow">01 / The big picture</p>
    <div class="intro-grid">
      <h2 class="big-h split">Good marketing gets attention.<br><em>Great marketing</em> earns growth.</h2>
      <div data-fade>
        <p class="large-copy">VSM Marketing helps businesses get seen, trusted and chosen through strategy, content and performance campaigns.</p>
        <p class="muted">From reels and brand films to paid campaigns, search visibility and websites that convert, one team connects the moving parts of growth. Started in Meerut in 2021, with a branch in Noida.</p>
        <a class="under-link" href="/studio/">Get to know VSM <i>↗</i></a>
      </div>
    </div>
  </section>

  <section class="proof-strip">
    <div class="proof-heading"><p class="eyebrow">Built on momentum</p><p>Five years of local brands, real budgets and reviews on Google.</p></div>
    {s.stats.map((x) => <div class="proof-item"><strong data-count>{x.value}</strong><span>{x.label}</span></div>)}
  </section>

  <section class="section-pad" id="work">
    <div class="section-heading">
      <div><p class="eyebrow">02 / Selected work</p><h2 class="big-h split">Work that<br><em>moves the needle.</em></h2></div>
      <a class="under-link" href="/work/">All projects <i>↗</i></a>
    </div>
    <WorkGrid />
  </section>

  <Brands />

  <section class="dark section-pad" id="services">
    <div class="section-heading">
      <div><p class="eyebrow">03 / What we do</p><h2 class="big-h split">One partner.<br><em>Every moving part.</em></h2></div>
      <p class="section-aside">Social & video, ads, SEO, web, software and reputation, connected around the growth goals that matter to your business.</p>
    </div>
    <ServiceList />
  </section>

  <Different />

  <section class="section-pad">
    <div class="section-heading">
      <div><p class="eyebrow">04 / Who we help</p><h2 class="big-h split">Built for the<br><em>business you run.</em></h2></div>
      <p class="section-aside">Industry-aware marketing for the way your customers discover, compare and choose. Pick yours to start.</p>
    </div>
    <Industries />
  </section>

  <Approach />
  <Certified />
  <Team />
  <Pricing />
  <Reviews />
  <Faq items={s.faqs} />
  <ContactBand />
</Base>
