---
import logo from '../assets/vsm-logo.svg?raw';
---
<div class="splash-ui" aria-hidden="true" data-splash>
  <div class="splash-stage"><Fragment set:html={logo} /></div>
  <div class="splash-meta">
    <span class="splash-count">000</span>
    <span class="splash-line"><i></i></span>
    <span>VSM / MAKING NOISE SINCE 2021</span>
  </div>
  <button class="splash-skip" type="button">Skip</button>
</div>
