---
import Icon from './Icon.astro';
---
<div class="fabs">
  <button class="fab fab-chat" type="button" data-chat-open aria-label="Chat with VSM assistant" data-track="chat_fab"><svg class="ico" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 9.5h7M8.5 12.5h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>Ask VSM</span></button>
  <a class="fab fab-call" href="tel:+918279574755" aria-label="Call VSM on +91 82795 74755" data-track="call_fab"><Icon name="phone" size={24} /><span>Call now</span></a>
  <a class="fab fab-wa" href="https://wa.me/918279574755?text=Hi%20VSM%2C%20I%27d%20like%20to%20talk%20about%20my%20business." target="_blank" rel="noopener" aria-label="Chat with VSM on WhatsApp" data-track="whatsapp_fab"><Icon name="wa" size={28} /><span>WhatsApp</span></a>
</div>
