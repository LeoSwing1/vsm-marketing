---
import Base from '../layouts/Base.astro';
import SubHero from './SubHero.astro';
interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---
<Base title={`${title} | VSM Marketing`} description={description}>
  <SubHero crumb={[{ label: 'Home', href: '/' }, { label: 'Legal' }]}>{title}</SubHero>
  <article class="legal"><div class="inner"><p class="updated">Last updated {updated}</p><slot /></div></article>
</Base>
