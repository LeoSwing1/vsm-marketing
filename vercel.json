{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "services": {
    "app": {
      "root": ".",
      "framework": "astro"
    },
    "studio": {
      "root": "sanity",
      "framework": "sanity"
    }
  },
  "redirects": [
    { "source": "/services/video-production/", "destination": "/services/social-media/", "permanent": true },
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ],
  "rewrites": [
    { "source": "/admin/(.*)", "destination": { "service": "studio" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
